# Copy to .env in this server folder. Values here are placeholders only.
PORT=4000
HOST=127.0.0.1
CLIENT_ORIGIN=http://127.0.0.1:5173
API_ORIGIN=http://127.0.0.1:4000

# Required for accounts and persistent memes. Blank means anonymous demo mode only.
MONGODB_URI=

# Gemini is configured as the initial provider; add your own key to server/.env.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_MAX_REQUESTS_PER_WINDOW=8

# Required for secure login cookies. Generate a random secret of at least 32 bytes.
JWT_SECRET=

# Optional one-time admin bootstrap only. Remove these after running `npm run admin:bootstrap --workspace server`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
