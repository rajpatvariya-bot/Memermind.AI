{
  "name": "mememind-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first meme creation studio built with React, Express, and MongoDB.",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "start": "npm run start --workspace server"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

